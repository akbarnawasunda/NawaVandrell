# ============================================================
# NawaVandrell 2.0 — contoh environment
# Copy jadi .env.local untuk development:
#   cp .env.example .env.local
# Di Vercel: Project Settings -> Environment Variables
# JANGAN commit .env.local ke GitHub.
# ============================================================

# --- WAJIB: akses panel admin (/admin) ---
# PIN yang diketik di form login admin. Pakai yang panjang, jangan 1234.
ADMIN_PIN=ganti-pin-ini-1234

# Token Bearer untuk semua endpoint /api/admin/* dan penulisan massal leaderboard.
# Bikin acak: openssl rand -hex 32
ADMIN_API_TOKEN=ganti-token-acak-yang-panjang-dan-rahasia

# --- OPSIONAL: penyimpanan leaderboard permanen ---
# Kalau dua-duanya diisi, leaderboard pakai Vercel KV / Upstash Redis (REST API).
# Kalau dikosongkan, otomatis fallback ke file (/tmp + data/leaderboard.json).
# Vercel: Storage -> KV -> Create, lalu Connect ke project (env terisi otomatis).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- OPSIONAL: fitur yang butuh server pihak ketiga ---
# Hanya dipakai TikTok Downloader dan galeri waifu.
# Semua tool & game lain jalan 100% tanpa ini.
# Contoh: https://api.nexray.eu.cc
UPSTREAM_API_BASE=
