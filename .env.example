# ============================================================
# Nawa Editor — contoh environment
# Salin ke .env.local dan ganti setiap nilai rahasia dengan nilai acak.
# Jangan commit .env.local atau membagikan secret lewat chat.
# ============================================================

# --- WAJIB untuk membuka area admin ---
# Rahasia login minimal 16 karakter; contoh generator: openssl rand -hex 16
ADMIN_PIN=

# Kunci HMAC sesi admin, minimal 32 karakter; wajib berbeda dari ADMIN_PIN.
# Generator: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Opsional untuk otomasi admin di luar website. Tidak pernah dikirim ke browser.
# Generator: openssl rand -hex 32
ADMIN_API_TOKEN=

# --- OPSIONAL: penyimpanan leaderboard dan rate limit login lintas instance ---
# Jika tersedia, Upstash/Vercel KV dipakai untuk menyimpan leaderboard dan
# menghitung percobaan login admin bersama antar-instance.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- OPSIONAL: layanan pihak ketiga untuk fitur online ---
# Hanya dipakai TikTok Downloader dan galeri tertentu.
UPSTREAM_API_BASE=
